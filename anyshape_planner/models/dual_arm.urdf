<?xml version="1.0"?>
<robot name="dual_arm">
  <link name="torso">
    <collision><geometry><box size="1.36 .34 .22"/></geometry></collision>
  </link>
  <link name="left_upper">
    <collision><origin xyz=".18 0 0"/><geometry><box size=".36 .084 .10"/></geometry></collision>
  </link>
  <link name="right_upper">
    <collision><origin xyz=".18 0 0"/><geometry><box size=".36 .084 .10"/></geometry></collision>
  </link>
  <link name="left_forearm">
    <collision><origin xyz=".155 0 0"/><geometry><box size=".31 .084 .092"/></geometry></collision>
  </link>
  <link name="right_forearm">
    <collision><origin xyz=".155 0 0"/><geometry><box size=".31 .084 .092"/></geometry></collision>
  </link>
  <joint name="left_shoulder" type="revolute">
    <parent link="torso"/><child link="left_upper"/>
    <origin xyz=".30 .25 0" rpy="0 0 1.5707963267948966"/><axis xyz="0 0 1"/>
    <limit lower="-.35" upper="2.05" velocity="1.5" effort="1"/>
  </joint>
  <joint name="right_shoulder" type="revolute">
    <parent link="torso"/><child link="right_upper"/>
    <origin xyz=".30 -.25 0" rpy="0 0 -1.5707963267948966"/><axis xyz="0 0 -1"/>
    <limit lower="-.35" upper="2.05" velocity="1.5" effort="1"/>
  </joint>
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper"/><child link="left_forearm"/>
    <origin xyz=".36 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.85" upper="1.85" velocity="1.8" effort="1"/>
  </joint>
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper"/><child link="right_forearm"/>
    <origin xyz=".36 0 0"/><axis xyz="0 0 -1"/>
    <limit lower="-1.85" upper="1.85" velocity="1.8" effort="1"/>
  </joint>
</robot>
